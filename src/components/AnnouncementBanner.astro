---
import { announcement } from '@data/announcement';
import { XMarkIcon, ExclamationTriangleIcon } from '@heroicons/react/24/outline';
---

{
  announcement && (
    <aside
      hidden
      aria-label="Site announcement"
      aria-live="polite"
      class:list={['bg-accent', 'text-zinc-800']}
      data-announcement-banner
      data-announcement={JSON.stringify(announcement)}
      id="site-announcement"
    >
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3">
        <p class="font-ut flex flex-1 items-center gap-2 text-lg font-medium">
          {<ExclamationTriangleIcon aria-hidden="true" className="size-6 shrink-0" />}
          <span>{announcement.message}</span>
        </p>
        <div class="-mr-2 flex items-center gap-2">
          {announcement.action && (
            <a
              class="custom-style font-ut rounded px-2 py-1 font-medium underline underline-offset-4 hover:bg-zinc-800/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
              href={announcement.action.href}
            >
              {announcement.action.label}
            </a>
          )}
          <button
            aria-label="Dismiss site announcement"
            class="inline-flex size-8 items-center justify-center rounded text-2xl leading-none hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
            data-dismiss-announcement
            title="Dismiss site announcement"
            type="button"
          >
            <XMarkIcon aria-hidden="true" className="size-6" />
          </button>
        </div>
      </div>
    </aside>
  )
}

<script>
  import { announcementDismissalKey, shouldDisplayAnnouncement, type Announcement } from '@utils/announcement';

  const banner = document.querySelector<HTMLElement>('[data-announcement-banner]');
  const configuredAnnouncement = banner?.dataset.announcement;

  if (banner && configuredAnnouncement) {
    const announcement = JSON.parse(configuredAnnouncement) as Announcement;
    const dismissalKey = announcementDismissalKey(announcement);
    let isDismissed = false;

    try {
      isDismissed = localStorage.getItem(dismissalKey) === 'true';
    } catch {}

    if (!isDismissed && shouldDisplayAnnouncement(announcement, window.location.pathname)) {
      banner.hidden = false;

      banner.querySelector<HTMLButtonElement>('[data-dismiss-announcement]')?.addEventListener('click', () => {
        banner.hidden = true;

        try {
          localStorage.setItem(dismissalKey, 'true');
        } catch {}
      });
    }
  }
</script>
