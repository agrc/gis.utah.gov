---
import { getBlogFilters, slugify, type BlogFilter } from '@utils/collections';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  team: string;
  tags?: string[];
  email: string;
  x?: string;
  photo?: string;
}

const convert = (name: string) => name.toLowerCase().replaceAll(' ', '-');

const { name, team, x, tags, email } = Astro.props;

const location = '/src/images/pillar-contact/staff/';
const images = import.meta.glob<{ default: ImageMetadata }>('/src/images/pillar-contact/staff/*.{svg,png}');
const authorFilters = await getBlogFilters('authors');
const authorFiltersLookup = authorFilters.reduce<Record<string, BlogFilter>>((acc, filter) => {
  acc[filter.slug] = filter;

  return acc;
}, {});
const authorFilter = authorFiltersLookup[slugify(name)];
---

<li>
  <div class="sm:grid-cols-3-150 grid h-60 grid-cols-150 items-center gap-1 p-3">
    <Image
      class="border-primary/90 dark:border-accent size-32 rounded-full border-2 shadow-xl"
      src={images[`${location}${convert(name)}.png`]()}
      alt={`portrait of ${name} with a white background`}
      width={128}
      height={128}
    />
    <div>
      <h3 class="text-base leading-7 font-semibold tracking-tight">{name}</h3>
      <div class="text-secondary dark:text-accent text-base">
        <p class="text-sm leading-6 font-semibold">
          <a href={`mailto:${email}`}>{email}</a>
        </p>
        {
          x && (
            <p class="text-sm leading-6 font-semibold">
              <a href={`https://x.com/${x}`}>{x}</a>
            </p>
          )
        }
      </div>
      {
        authorFilter?.posts.length > 0 ? (
          <a class="text-sm" href={`/blog/authors/${authorFilter.slug}/`}>
            authored posts
          </a>
        ) : null
      }
      <div class="text-sm leading-6 font-semibold">
        <div class="flex items-center text-base text-zinc-600 dark:text-zinc-300">
          <p class="text-sm leading-6 font-medium">{team}</p>
        </div>
      </div>
    </div>
    <div
      class="col-span-2 flex flex-row flex-wrap items-end justify-center gap-2 self-center text-xs sm:col-span-1 sm:flex-col sm:gap-0.5"
    >
      {
        tags &&
          tags
            .sort((a, b) => a.length - b.length)
            .map((tag) => (
              <div class="border-secondary bg-primary/90 dark:border-accent/30 dark:bg-secondary self-center rounded-full border px-4 py-1 text-center font-semibold text-zinc-50 lowercase select-none">
                {tag.replaceAll(' ', '-')}
              </div>
            ))
      }
    </div>
  </div>
</li>
