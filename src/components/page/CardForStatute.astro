---
import RightArrow from './RightArrow.astro';

interface Props {
  href: string;
  code: string;
  title: string;
  style?: 'primary' | 'secondary';
}
const { href, code, title, style = 'primary' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'custom-style flex rounded-lg border border-zinc-400 bg-primary px-6 py-3 text-zinc-50 shadow focus:border-transparent focus:outline-none focus:ring-4 focus:ring-accent dark:border-white/20',
    style === 'secondary' && 'dark:bg-secondary',
  ]}
>
  <div class="flex grow flex-col">
    <h4 class="uppercase text-zinc-50">{title}</h4>
    <p class="font-semibold uppercase text-accent">{code}</p>
    <div class="primary-background pr-2 text-sm text-zinc-50">
      <slot />
    </div>
  </div>
  <RightArrow />
</a>
